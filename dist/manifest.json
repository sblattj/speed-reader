{
  "manifest_version": 3,
  "name": "Speed Reader",
  "version": "1.3.1",
  "description": "Speed read a page, selection, or picked element in an in-page overlay: RSVP, chunk, and pacer modes, no accounts, no network calls.",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage", "commands"],
  "optional_host_permissions": ["<all_urls>"],
  "options_ui": {
    "page": "grant.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Speed Reader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "speed-read-page": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Speed read this page"
    },
    "speed-read-selection": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Speed read selection"
    }
  }
}
